import { useState } from "react";

function Carrinho() {
  const [carrinho, setCarrinho] = useState([]);

  // Calcula o valor total
  const total = carrinho.reduce((soma, produto) => {
    return soma + produto.preco * produto.quantidade;
  }, 0);

  // Calcula a quantidade de itens
  const quantidadeTotal = carrinho.reduce((soma, produto) => {
    return soma + produto.quantidade;
  }, 0);

  return (
    <div>
      <h2>Resumo do Pedido</h2>

      <p>Quantidade de itens: {quantidadeTotal}</p>

      <p>
        Total a pagar: R$ {total.toFixed(2)}
      </p>

      {quantidadeTotal > 0 && (
        <p>Seu pedido está pronto!</p>
      )}

      {quantidadeTotal === 0 ? (
        <p>Seu carrinho está vazio.</p>
      ) : (
        <p>Obrigado pela sua compra!</p>
      )}
    </div>
  );
}
